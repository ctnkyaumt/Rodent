<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- No WinForms: the tray icon is plain Win32 (TrayIcon.cs). Referencing it
         pulled ~29 MB of assemblies into the self-contained build for one icon. -->
    <!-- English only: the framework's localized resource satellites are ~16 MB. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Rodent</AssemblyName>
    <ApplicationIcon>Assets\rodent.ico</ApplicationIcon>
    <!-- Overridden by CI with -p:Version=<tag> on releases. -->
    <Version>0.9.0</Version>
    <!-- Own Main (Program.cs): CLI commands answer and exit before WPF starts. -->
    <StartupObject>Rodent.App.Program</StartupObject>
  </PropertyGroup>

  <!-- App.xaml as a Page rather than ApplicationDefinition, so the SDK does not
       generate a competing entry point. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rodent.Core\Rodent.Core.csproj" />
    <PackageReference Include="SharpVectors.Reloaded" Version="1.8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.svg" />
    <Resource Include="Assets\rodent.ico" />
  </ItemGroup>

  <!--
    The WindowsDesktop runtime pack is monolithic: a self-contained publish ships
    WinForms whether or not the app references it (UseWindowsForms only drops the
    compile-time reference), and WPF apps can't be trimmed. Rodent's only WinForms
    use was the tray icon, now plain Win32, so these ~23 MB are never loaded —
    verified with Process.Modules on a full session. Drop them from the publish.
  -->
  <Target Name="DropUnusedWinForms" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(Filename)').StartsWith('System.Windows.Forms'))
                                     Or '%(Filename)' == 'System.Drawing.Common'
                                     Or '%(Filename)' == 'System.Drawing.Design'
                                     Or '%(Filename)' == 'Accessibility'" />
    </ItemGroup>
  </Target>

</Project>
